FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
RUN id app >/dev/null 2>&1 || adduser --disabled-password --home /app --gecos "" app
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src

# Copy proto definitions and C# source (build context = monorepo root)
COPY toska-mesh-proto/ ./toska-mesh-proto/
COPY toska-mesh-cs/ ./toska-mesh-cs/

# Restore and publish in one go
WORKDIR /src/toska-mesh-cs/src/Services/ToskaMesh.ObservabilityService
RUN dotnet publish -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .
RUN chown -R app:app /app
USER app
ENTRYPOINT ["dotnet", "ToskaMesh.ObservabilityService.dll"]
